# Copie para ".env" (cp .env.example .env), preencha e proteja: chmod 600 .env
# NUNCA envie o .env para o GitHub nem compartilhe estas chaves.

# paper   = dados reais de mercado, ordens SIMULADAS (padrão, sem chaves)
# testnet = ordens reais na testnet da Binance (dinheiro de mentira; precisa de chaves da testnet)
# live    = DINHEIRO REAL (exige também a flag --live na linha de comando)
MODE=paper

# Chaves da API da Binance (só necessárias em testnet/live).
# Permissões: Leitura + Trading Spot LIGADOS; Saques DESLIGADO; restrinja ao seu IP.
EXCHANGE_API_KEY=
EXCHANGE_SECRET_KEY=

# Ativos operados (spot), separados por vírgula. TODOS com a MESMA moeda de cotação.
# Vazio = 12 grandes em BRL (a banca está em reais). Pares que a Binance não lista são ignorados e avisados no `check`.
# Use uma conta/subconta DEDICADA com apenas a banca na moeda de cotação.
SYMBOLS=BTC/BRL,ETH/BRL,SOL/BRL,XRP/BRL,ADA/BRL,DOGE/BRL,LINK/BRL,LTC/BRL,AVAX/BRL,DOT/BRL,TRX/BRL,SHIB/BRL
# Banca na moeda de cotação (BRL nos pares /BRL; USDT se você usar pares /USDT e tiver USDT na conta).
BANKROLL_BRL=50
# Fusível: dispara quando o patrimônio TOTAL (soma de todos os ativos) perde este % da baseline (60% de 50 => piso 20).
MAX_LOSS_PCT=60

TIMEFRAME=5m
TICK_SECONDS=30

# Darwinismo
INITIAL_AGENTS=1
EVAL_MIN_ROUNDTRIPS=3
EVAL_MAX_TICKS=400
# false (padrão): ciclo SEM nenhum trade não mata o agente (não há PnL para julgar). true = regra literal "PnL 0 morre".
IDLE_KILLS=false
# true (padrão): se o ÚLTIMO agente morrer, nasce um novo (parâmetros mutados) com o capital restante, desde que viável.
# false = regra literal: sem agentes, o robô encerra (extinção). O fusível de perda total vale nos dois casos.
REVIVE=true
# Proteções: cooldown após vender (candles) e pausa após K stop-loss em 24 candles (0 = desligado)
COOLDOWN_CANDLES=2
STOPLOSS_GUARD=3
# Dado desatualizado: se o candle mais novo for mais velho que (1+N) períodos, o ativo é ignorado naquele tick
# (e conta como falha de mercado se houver posição nele). Padrão 3.
MAX_STALE_CANDLES=3
# Tolerância: o agente só morre se a perda do ciclo passar de X% do capital dele (0 = regra literal: PnL <= 0 morre).
# Perda dentro da tolerância = sobrevive, mas NÃO clona. Máximo 20.
DEATH_TOLERANCE_PCT=0
# true = só julga/mata um agente depois de EVAL_MIN_ROUNDTRIPS trades; antes disso o ciclo é renovado.
DEATH_NEEDS_MIN_TRADES=false
# Filtro de tendência longa: 0 = desligado; 50-400 = só compra com o preço acima da média dos últimos N candles
# (e vende se cair abaixo). Teste antes no backtest: python main.py backtest --optimize --trend-filter
TREND_PERIOD=0
MAX_POPULATION=4
MAX_GENERATION=5
MAX_ORDERS_PER_HOUR=12

# Sentimento (Ollama local e gratuito)
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
# Feeds RSS separados por vírgula (somente https). Vazio = CoinDesk + Cointelegraph.
NEWS_FEEDS=

# (Opcional) Arquivo com parâmetros de estratégia escolhidos pelo backtest (`backtest --optimize` gera
# backtest_out/best_params.json). Só vale na criação dos agentes (`init`). Deixe vazio para usar o padrão.
STRATEGY_PARAMS_FILE=

# Token para reabrir o disjuntor depois de disparar (escolha um segredo longo)
DARWIN_RESET_TOKEN=
DATA_DIR=data
