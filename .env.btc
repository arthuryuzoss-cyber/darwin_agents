# Configuração SÓ para pesquisa de longo prazo (não é para o robô rodar!).
# Copie para .env.longo e use:  python main.py --env-file .env.longo download --days 3650 --timeframe 1d
# Pares em USDT têm histórico desde ~2017 (os em BRL só ~4 anos). O USDT é um substituto razoável do BRL para
# testar a lógica; não é igual (sem câmbio, sem liquidez brasileira).
MODE=paper
DATA_DIR=data_btc
BANKROLL_BRL=100
SYMBOLS=BTC/USDT,ETH/USDT